#!/bin/sh
# Refuse to commit private values (see tools/check_secrets.py), so a leak is
# caught here rather than discovered in a public repo later.
# Enable once per clone:  git config core.hooksPath githooks
# A deliberate value:     add it to the ALLOW_* sets in tools/check_secrets.py,
#                         or put `secrets-ok` on the line
# Skip once:              git commit --no-verify

root=$(git rev-parse --show-toplevel)
py="$root/infra/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/infra/.venv/bin/python"
if [ ! -x "$py" ]; then
    # A fresh clone of the public repo may not have the venv yet; don't block
    # commits over a check that can't run.
    py=$(command -v python3 || command -v python || echo "")
fi
if [ -z "$py" ]; then
    echo "check_secrets: no python found, skipping the secrets check." >&2
    exit 0
fi
exec "$py" "$root/tools/check_secrets.py" --staged
